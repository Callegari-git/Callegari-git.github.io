---
/**
 * Section pattern: hairline separator → "> LABEL" mono label → serif h2 → content.
 */
interface Props {
  id: string;
  label: string;
  /** Optional: without it, the "> LABEL" line itself is the section heading. */
  title?: string;
  width?: 'text' | 'grid';
}

const { id, label, title, width = 'grid' } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class="gutter scroll-mt-4 border-t border-rule">
  {/* Outer container is always the grid width so every section shares the same left edge. */}
  <div class="mx-auto max-w-grid py-14 md:py-20">
    {
      title ? (
        <>
          <p class="label mb-4">
            <span class="mr-2 text-accent" aria-hidden="true">&gt;</span>
            {label}
          </p>
          <h2 id={headingId} class="mb-8 text-h2 md:mb-12">{title}</h2>
        </>
      ) : (
        <h2 id={headingId} class="label mb-6">
          <span class="mr-2 text-accent" aria-hidden="true">&gt;</span>
          {label}
        </h2>
      )
    }
    <div class:list={[width === 'text' && 'max-w-text']}>
      <slot />
    </div>
  </div>
</section>
