---
import { person } from '../data/site';

// Order mirrors the page.
const nav = [
  { label: 'Experience', href: '/#experience' },
  { label: 'Work', href: '/#work' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="gutter border-b border-rule">
  <div class="mx-auto flex min-h-16 max-w-grid flex-wrap items-center justify-between gap-x-3 gap-y-1 py-3 sm:gap-x-4">
    <a href="/" class="font-display text-[0.9375rem] whitespace-nowrap text-ink no-underline hover:text-accent sm:text-lead">
      {person.name}
    </a>
    <nav aria-label="Primary">
      <ul class="flex gap-3 text-sm sm:gap-6">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-2 no-underline hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
