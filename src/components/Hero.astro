---
import ProfileLinks from './ProfileLinks.astro';
import { person, links } from '../data/site';

const facts = [
  { label: 'Role', value: person.role },
  { label: 'Company', value: person.company },
  { label: 'Based in', value: person.location },
  { label: 'Open to', value: person.openTo },
];
---

<section aria-labelledby="hero-title" class="gutter">
  <div class="mx-auto max-w-grid pt-12 pb-12 md:pt-16 md:pb-16">
    <p class="label mb-4">{person.roleLine}</p>
    <h1 id="hero-title" class="text-h1">{person.name}</h1>

    <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-3">
      {
        facts.map((fact) => (
          <div>
            <dt class="label">{fact.label}</dt>
            <dd class="mt-1 text-ink">{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-8 max-w-text font-display text-h2 text-ink">{person.headline}</p>
    <p class="mt-4 max-w-text text-lead">{person.subline}</p>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={person.cvHref} class="btn btn-primary" download>
        Download CV
        <span aria-hidden="true">↓</span>
      </a>
      <ProfileLinks links={links} />
    </div>
  </div>
</section>
