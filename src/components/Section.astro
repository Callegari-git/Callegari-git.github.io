---
/**
 * Section pattern: hairline separator → mono label (with optional index) → serif h2 → content.
 */
interface Props {
  id: string;
  label: string;
  title: string;
  index?: string;
  width?: 'text' | 'grid';
}

const { id, label, title, index, width = 'grid' } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class="gutter scroll-mt-4 border-t border-rule">
  {/* Outer container is always the grid width so every section shares the same left edge. */}
  <div class="mx-auto max-w-grid py-16 md:py-24">
    <p class="label mb-4">
      {index && <span class="mr-2 text-accent">{index}</span>}
      {label}
    </p>
    <h2 id={headingId} class="mb-8 text-h2 md:mb-12">{title}</h2>
    <div class:list={[width === 'text' && 'max-w-text']}>
      <slot />
    </div>
  </div>
</section>
