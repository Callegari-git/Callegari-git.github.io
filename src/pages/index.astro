---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MoreProjects from '../components/MoreProjects.astro';
import Timeline from '../components/Timeline.astro';
import CvLinks from '../components/CvLinks.astro';
import EmailPopover from '../components/EmailPopover.astro';
import { person, isPlaceholder } from '../data/site';
import { getFeatured, getMore } from '../lib/projects';

const featured = await getFeatured();
const more = await getMore();

const title = `${person.name} · Software / AI Engineer`;
const description = person.subline;
---

<BaseLayout title={title} description={description}>
  <Hero />

  <Section id="experience" label="Experience" title="Where I've worked">
    <Timeline />
  </Section>

  <Section id="work" label="Selected work" title="Featured projects">
    <div class="grid gap-4">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <MoreProjects projects={more} />
  </Section>

  <Section id="contact" label="Contact">
    <CvLinks />
  </Section>

  {/* Opened by the Email buttons in the hero and Contact section. */}
  {!isPlaceholder(person.email) && <EmailPopover />}
</BaseLayout>
