---
import MetricValue from './MetricValue.astro';
import StatusBadge from './StatusBadge.astro';
import { projectHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, category, summary, metrics, stack, page } = project.data;
const highlight = metrics[0];
const href = page ? projectHref(project) : undefined;
// Linked cards use a stretched link: the whole card is clickable, but only the title is announced.
---

<article
  class:list={[
    'group relative flex flex-col rounded-[4px] border border-ink/15 bg-surface p-6',
    href &&
      'transition duration-300 ease-out focus-within:border-accent hover:-translate-y-0.5 hover:border-accent motion-reduce:hover:translate-y-0',
  ]}
>
  <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
    <p class="label">{category}</p>
    <StatusBadge project={project} />
  </div>

  <h3 class="mb-2 text-h3">
    {
      href ? (
        <a
          href={href}
          class="text-ink no-underline group-hover:text-accent after:absolute after:inset-0 after:content-['']"
        >
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <p class="mb-6">{summary}</p>

  {
    highlight ? (
      <p class="mb-6">
        <MetricValue
          value={highlight.value}
          estimated={highlight.estimated}
          class="block text-metric font-semibold text-accent"
        />
        <span class="mt-1 block text-sm text-ink-2">{highlight.label}</span>
      </p>
    ) : (
      <p class="mb-6 font-mono text-label text-muted">[CONFIRM: key result]</p>
    )
  }

  {
    stack.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2" aria-label="Stack">
        {stack.slice(0, 4).map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>
    )
  }

  {href && <p class="mt-6 text-sm font-semibold text-accent" aria-hidden="true">Case study →</p>}
</article>
