---
/**
 * Profile links; "[CONFIRM …]" placeholders render as plain text, never as links.
 * "Email" is a button that opens the email dialog (EmailPopover) instead of a bare
 * mailto: link, which does nothing on machines with no mail app configured.
 */
import { isPlaceholder, EMAIL_POPOVER_ID, type ProfileLink } from '../data/site';

interface Props {
  links: ProfileLink[];
  class?: string;
}

const { links, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-x-6 gap-y-2', className]} aria-label="Profiles">
  {
    links.map((link) => {
      if (isPlaceholder(link.href)) {
        return <li class="font-mono text-label text-muted">{link.href}</li>;
      }
      if (link.href.startsWith('mailto:')) {
        return (
          <li>
            <button type="button" popovertarget={EMAIL_POPOVER_ID} aria-haspopup="dialog" class="link-button text-sm font-semibold">
              {link.label}
            </button>
          </li>
        );
      }
      const external = link.href.startsWith('http');
      return (
        <li>
          <a
            href={link.href}
            class="text-sm font-semibold"
            {...(external ? { rel: 'me noopener', target: '_blank' } : {})}
          >
            {link.label}
            {external && <span aria-hidden="true"> ↗</span>}
            {external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </li>
      );
    })
  }
</ul>
