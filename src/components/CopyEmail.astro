---
/**
 * "Copy" button for the email address (used inside EmailPopover). Progressive
 * enhancement: the button is hidden until the script confirms the Clipboard API is
 * available, so without JS only the (selectable) address is shown. This script is
 * the one documented exception to "zero JS outside the animation island" (see CLAUDE.md).
 */
interface Props {
  email: string;
  /** Candidate for initial focus when the surrounding popover opens. */
  autofocus?: boolean;
}

const { email, autofocus = false } = Astro.props;
---

<button type="button" class="copy-email btn btn-primary" data-copy-email={email} autofocus={autofocus} hidden>
  <span data-copy-label>Copy</span><span class="sr-only"> email address</span>
</button>
<span class="sr-only" role="status" data-copy-status></span>

<script>
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
      const label = button.querySelector('[data-copy-label]');
      const status = button.nextElementSibling;
      let timer: number | undefined;

      button.hidden = false;
      button.addEventListener('click', async () => {
        let ok = true;
        try {
          await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        } catch {
          ok = false;
        }
        if (label) label.textContent = ok ? 'Copied' : 'Failed';
        if (status) status.textContent = ok ? 'Email address copied' : 'Could not copy. Select the address instead.';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (label) label.textContent = 'Copy';
          if (status) status.textContent = '';
        }, 2000);
      });
    }
  }
</script>

<style>
  /* Fixed width so "Copy" → "Copied" does not shift the button next to it. */
  .copy-email {
    min-width: 6.5rem;
    justify-content: center;
  }
</style>
