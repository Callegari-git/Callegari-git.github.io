---
/** Credentials body: education, key numbers, stack groups. Rendered twice by Credentials.astro. */
import { getCollection } from 'astro:content';
import { keyNumbers, stackGroups } from '../data/site';

const education = (await getCollection('education')).sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const year = (d: Date) => d.getUTCFullYear();
---

<div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
  <div class="lg:col-span-5">
    <h3 class="label mb-4">Education</h3>
    <ul class="space-y-5">
      {
        education.map(({ data }) => (
          <li>
            <p class="font-mono text-label text-muted">
              {year(data.start)} – {year(data.end)}
            </p>
            <p class="mt-1 font-display text-lead text-ink">{data.school}</p>
            <p class="text-sm text-ink-2">{data.degree}</p>
            {data.details && <p class="mt-1 text-sm text-muted">{data.details}</p>}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="lg:col-span-3">
    <h3 class="label mb-4">Key numbers</h3>
    <dl class="space-y-5">
      {
        keyNumbers.map((n) => (
          <div class="flex flex-col gap-1">
            <dt class="order-2 text-sm">{n.label}</dt>
            <dd class="order-1 text-metric font-semibold text-ink tabular-nums">{n.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="lg:col-span-4">
    <h3 class="label mb-4">Stack</h3>
    <dl class="space-y-4">
      {
        stackGroups.map((group) => (
          <div>
            <dt class="text-sm font-semibold text-ink">{group.label}</dt>
            <dd class="mt-1 text-sm">{group.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
