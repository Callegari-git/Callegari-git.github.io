---
import MetricValue from './MetricValue.astro';
import { metrics, estimateNote } from '../data/site';

const hasEstimate = metrics.some((m) => m.estimated || /\best\./.test(m.label));
---

<section aria-label="Key metrics" class="gutter border-t border-rule">
  <div class="mx-auto max-w-grid py-10 md:py-12">
    <dl class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        metrics.map((metric) => (
          <div class="flex flex-col gap-2">
            {/* dt stays first for screen readers; the number is shown on top. */}
            <dt class="order-2 text-sm">{metric.label}</dt>
            <dd class="order-1 text-metric font-semibold text-ink">
              <MetricValue value={metric.value} estimated={metric.estimated} />
            </dd>
          </div>
        ))
      }
    </dl>
    {hasEstimate && <p class="mt-8 font-mono text-label text-muted">{estimateNote}</p>}
  </div>
</section>
