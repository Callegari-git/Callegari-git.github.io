---
/**
 * Credentials panel, zero JS.
 * Desktop (lg+): always-open panel. Below lg: a closed <details>.
 * The content is rendered twice; CSS hides one copy (display: none), so assistive tech only sees the visible one.
 */
import CredentialsContent from './CredentialsContent.astro';
---

<div class="hidden rounded-[4px] border border-rule bg-surface p-8 lg:block">
  <CredentialsContent />
</div>

<details class="credentials group rounded-[4px] border border-rule bg-surface lg:hidden">
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
  >
    Education, key numbers and stack
    <span aria-hidden="true" class="font-mono text-lead text-accent group-open:hidden">+</span>
    <span aria-hidden="true" class="hidden font-mono text-lead text-accent group-open:inline">−</span>
  </summary>
  <div class="border-t border-rule px-5 pt-6 pb-8">
    <CredentialsContent />
  </div>
</details>
