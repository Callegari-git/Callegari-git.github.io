---
import { principles } from '../data/site';
---

<ol class="border-t border-rule">
  {
    principles.map((item, i) => (
      <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-rule py-5">
        <span class="pt-1 font-mono text-label font-medium text-accent" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <p class="text-lead text-ink">{item}</p>
      </li>
    ))
  }
</ol>
