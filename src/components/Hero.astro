---
import ProfileLinks from './ProfileLinks.astro';
import { person, links, heroFacts } from '../data/site';

const sep = ' · ';
---

<section aria-labelledby="hero-title" class="gutter">
  <div class="mx-auto max-w-grid pt-12 pb-12 md:pt-16 md:pb-16">
    <p class="label mb-4">{person.kicker}</p>
    <h1 id="hero-title" class="text-h1">{person.name}</h1>
    <p class="mt-3 text-lead text-muted">{person.tagline}</p>

    {/* Label/value list: 2 columns from 640px, label above value below. */}
    <dl class="mt-8 grid max-w-text grid-cols-1 gap-y-4 sm:grid-cols-[7rem_1fr] sm:gap-x-6 sm:gap-y-3">
      <div class="sm:contents">
        <dt class="hero-dt">Schools</dt>
        <dd class="text-ink">
          {heroFacts.schools.map((item, i) => (
            <>
              {i > 0 && sep}
              <span class="whitespace-nowrap">{item}</span>
            </>
          ))}
        </dd>
      </div>
      <div class="sm:contents">
        <dt class="hero-dt">Focus</dt>
        <dd class="text-ink">
          {heroFacts.focus.map((item, i) => (
            <>
              {i > 0 && sep}
              <span class="whitespace-nowrap">{item}</span>
            </>
          ))}
        </dd>
      </div>
      <div class="sm:contents">
        <dt class="hero-dt">Now</dt>
        <dd>
          <span class="font-semibold text-ink">{heroFacts.now.title}</span>
          <span class="text-ink-2"> @ {heroFacts.now.org}</span>
        </dd>
      </div>
    </dl>

    <p class="mt-8 max-w-text font-display text-h2 text-ink">{person.headline}</p>
    <p class="mt-4 max-w-text text-lead">{person.subline}</p>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={person.cvHref} class="btn btn-primary" target="_blank" rel="noopener">
        View CV
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <ProfileLinks links={links} />
    </div>
  </div>
</section>

<style>
  /* Mono uppercase label with wide tracking, baseline-aligned with the Inter value. */
  .hero-dt {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .hero-dt {
      padding-top: 0.3em;
    }
  }
</style>
