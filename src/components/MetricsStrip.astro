---
import { metrics } from '../data/site';
---

<section aria-label="Key metrics" class="gutter border-t border-rule">
  <dl class="mx-auto grid max-w-grid grid-cols-2 gap-x-6 gap-y-8 py-10 md:grid-cols-4 md:py-12">
    {
      metrics.map((metric) => (
        <div class="flex flex-col gap-2">
          {/* dt stays first for screen readers; the number is shown on top. */}
          <dt class="label order-2">{metric.label}</dt>
          <dd class="order-1 text-metric font-semibold text-ink tabular-nums">{metric.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
