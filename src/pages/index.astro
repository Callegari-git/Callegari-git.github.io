---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MoreProjects from '../components/MoreProjects.astro';
import Expertise from '../components/Expertise.astro';
import Timeline from '../components/Timeline.astro';
import Principles from '../components/Principles.astro';
import Contact from '../components/Contact.astro';
import EmailPopover from '../components/EmailPopover.astro';
import { person, isPlaceholder } from '../data/site';
import { getFeatured, getMore } from '../lib/projects';

const featured = await getFeatured();
const more = await getMore();

const title = `${person.name} · Software / AI Engineer`;
const description = person.subline;
---

<BaseLayout title={title} description={description}>
  <Hero />

  <Section id="work" index="01" label="Selected work" title="Featured projects">
    <div
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:[&>*:last-child:nth-child(odd)]:col-span-2 lg:[&>*:last-child:nth-child(odd)]:col-span-1"
    >
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <MoreProjects projects={more} />
  </Section>

  <Section id="expertise" index="02" label="Expertise" title="What I work on">
    <Expertise />
  </Section>

  <Section id="experience" index="03" label="Experience" title="Where I've worked">
    <Timeline />
  </Section>

  <Section id="principles" index="04" label="Principles" title="How I work" width="text">
    <Principles />
  </Section>

  <Section id="contact" index="05" label="Contact" title="Let's talk">
    <Contact />
  </Section>

  {/* Opened by the Email buttons in the hero and Contact section. */}
  {!isPlaceholder(person.email) && <EmailPopover />}
</BaseLayout>
