---
import ProfileLinks from './ProfileLinks.astro';
import { person, links, isPlaceholder } from '../data/site';
---

<p class="mb-8 text-lead">{person.availability}</p>

<div class="flex flex-wrap items-center gap-x-6 gap-y-4">
  {
    isPlaceholder(person.email) ? (
      <p class="font-mono text-label text-muted">{person.email}</p>
    ) : (
      <a href={`mailto:${person.email}`} class="btn btn-primary">
        Email me
      </a>
    )
  }
  <ProfileLinks links={links.filter((link) => link.label !== 'Email')} />
</div>
