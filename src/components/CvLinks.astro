---
/** "View CV" button + profile links (Email / GitHub / LinkedIn). Used in the hero and the Contact section. */
import ProfileLinks from './ProfileLinks.astro';
import { person, links } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['flex flex-wrap items-center gap-x-6 gap-y-4', className]}>
  <a href={person.cvHref} class="btn btn-primary" target="_blank" rel="noopener">
    View CV
    <span aria-hidden="true">↗</span>
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  <ProfileLinks links={links} />
</div>
