---
import CvLinks from './CvLinks.astro';
import About from './About.astro';
import { person, heroFacts } from '../data/site';

const sep = ' · ';
---

<section aria-labelledby="hero-title" class="gutter">
  <div class="mx-auto max-w-grid pt-12 pb-12 md:pt-16 md:pb-16">
    <p class="label mb-4">{person.kicker}</p>
    <h1 id="hero-title" class="text-h1">{person.name}</h1>
    <p class="mt-3 font-mono text-base text-muted">{person.tagline}</p>

    {/* CV + links stay above the fold, before the facts and the About block. */}
    <CvLinks class="mt-6" />

    {/* Label/value list: 2 columns from 640px, label above value below. */}
    <dl class="mt-8 grid max-w-text grid-cols-1 font-mono text-sm gap-y-4 sm:grid-cols-[7rem_1fr] sm:gap-x-6 sm:gap-y-3">
      <div class="sm:contents">
        <dt class="hero-dt">Schools</dt>
        <dd class="text-ink">
          {heroFacts.schools.map((item, i) => (
            <>
              {i > 0 && sep}
              <span class="whitespace-nowrap">{item}</span>
            </>
          ))}
        </dd>
      </div>
      <div class="sm:contents">
        <dt class="hero-dt">Focus</dt>
        <dd class="text-ink">
          {heroFacts.focus.map((item, i) => (
            <>
              {i > 0 && sep}
              <span class="whitespace-nowrap">{item}</span>
            </>
          ))}
        </dd>
      </div>
      <div class="sm:contents">
        <dt class="hero-dt">Now</dt>
        <dd>
          <span class="font-semibold text-ink">{heroFacts.now.title}</span>
          <span class="text-ink-2"> @ {heroFacts.now.org}</span>
        </dd>
      </div>
    </dl>

    <div class="mt-12 max-w-text">
      <h2 class="hero-dt"><span class="mr-2 text-accent" aria-hidden="true">&gt;</span>About</h2>
      <About />
    </div>
  </div>
</section>

<style>
  /* Mono uppercase label with wide tracking, baseline-aligned with the Inter value. */
  .hero-dt {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .hero-dt {
      padding-top: 0.3em;
    }
  }
</style>
