---
import { person } from '../data/site';

// Order mirrors the page: Work → Expertise → Contact.
const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Expertise', href: '/#expertise' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="gutter border-b border-rule">
  <div class="mx-auto flex h-16 max-w-grid items-center justify-between gap-4">
    <a href="/" class="font-display text-base whitespace-nowrap text-ink no-underline hover:text-accent sm:text-lead">
      {person.name}
    </a>
    <nav aria-label="Primary">
      <ul class="flex gap-4 text-sm sm:gap-6">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-2 no-underline hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
